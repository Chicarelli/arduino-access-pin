# Port the server listens on (always bound to 0.0.0.0 so the ESP32 on the LAN can reach it).
PORT=3000

# Shared secret the ESP32 sends in the X-Device-Key header.
DEVICE_KEY=change-me-device-key

# Token for the admin API: Authorization: Bearer <ADMIN_TOKEN>
ADMIN_TOKEN=change-me-admin-token

# Secret mixed into every PIN hash (HMAC-SHA256). Use a long random value.
# WARNING: changing it later makes every stored PIN stop working.
PIN_PEPPER=change-me-to-a-long-random-string

# Generate random values with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Optional
# DB_PATH=data/gym.db
# LOG_LEVEL=info
